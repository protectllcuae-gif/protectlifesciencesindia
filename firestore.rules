rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products: public read, authenticated admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Metadata: public read, authenticated admin write
    match /metadata/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Orders: public create (guest / user checkout), authenticated read & write
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Enquiries / Leads from contact form
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, write, delete: if isAuthenticated();
    }

    // Coupons: public read for checkout validation, authenticated write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Team members & Admin permissions
    match /team/{memberId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Reviews & Testimonials
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Blogs & Insights
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User profiles & customer accounts
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }

    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

  }
}


